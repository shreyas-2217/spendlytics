# Copy this file to .streamlit/secrets.toml and fill in your own key.
# Both providers have free tiers — see the README for setup steps.
# Never commit the real secrets.toml (it is already in .gitignore).

# Google AI Studio (recommended): https://aistudio.google.com/apikey
GEMINI_API_KEY = "your-key-here"
# Optional: set the free model available in your account (see scripts/check_llm.py).
GEMINI_MODEL = "gemini-3.5-flash-lite"

# Groq (alternative): https://console.groq.com/keys
# GROQ_API_KEY = "your-key-here"
# GROQ_MODEL = "openai/gpt-oss-120b"
